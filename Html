
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Personal Assistant Dashboard</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    padding: 24px;
    font-family: Arial, sans-serif;
    background: #f1f5f9;
    color: #1e293b;
}

h1 { text-align: center; }

.subtitle {
    text-align: center;
    color: #64748b;
    margin-bottom: 28px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 16px;
    max-width: 1100px;
    margin: auto;
}

.card {
    background: white;
    padding: 22px;
    border-radius: 14px;
    text-align: center;
    box-shadow: 0 3px 12px #00000010;
}

.card h3 {
    color: #64748b;
    font-size: 15px;
}

.number {
    font-size: 34px;
    font-weight: bold;
    margin-top: 12px;
}

.charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    max-width: 1100px;
    margin: 25px auto;
}

.chart-box {
    background: white;
    padding: 22px;
    border-radius: 14px;
    box-shadow: 0 3px 12px #00000010;
    min-width: 0;
}

.chart-box h2 {
    font-size: 18px;
    text-align: center;
}

.chart-area {
    position: relative;
    height: 300px;
}

footer {
    text-align: center;
    color: #64748b;
    padding: 20px;
}
</style>
</head>

<body>

<h1>Personal Assistant Dashboard</h1>
<p class="subtitle">Task Management and Event Analytics</p>

<div class="cards">
    <div class="card">
        <h3>Total Tasks</h3>
        <div class="number" id="total">0</div>
    </div>
    <div class="card">
        <h3>Completed Tasks</h3>
        <div class="number" id="done">0</div>
    </div>
    <div class="card">
        <h3>Pending Tasks</h3>
        <div class="number" id="pending">0</div>
    </div>
    <div class="card">
        <h3>Calendar Events</h3>
        <div class="number" id="events">0</div>
    </div>
</div>

<div class="charts">
    <div class="chart-box">
        <h2>Task Completion Pie Chart</h2>
        <div class="chart-area">
            <canvas id="pieChart"></canvas>
        </div>
    </div>

    <div class="chart-box">
        <h2>Tasks by Priority</h2>
        <div class="chart-area">
            <canvas id="barChart"></canvas>
        </div>
    </div>

    <div class="chart-box">
        <h2>Completed vs Pending</h2>
        <div class="chart-area">
            <canvas id="statusChart"></canvas>
        </div>
    </div>
</div>

<footer>Personal Assistant | Min Heap and CSV Storage</footer>

<script>
const d = {"total": 5, "done": 1, "pending": 4, "events": 3, "priorities": [1, 3, 5], "priority_counts": [1, 2, 2]};

document.getElementById("total").textContent = d.total;
document.getElementById("done").textContent = d.done;
document.getElementById("pending").textContent = d.pending;
document.getElementById("events").textContent = d.events;

const commonOptions = {
    responsive: true,
    maintainAspectRatio: false
};

new Chart(document.getElementById("pieChart"), {
    type: "pie",
    data: {
        labels: ["Completed", "Pending"],
        datasets: [{
            data: [d.done, d.pending],
            backgroundColor: ["#22c55e", "#f59e0b"]
        }]
    },
    options: commonOptions
});

new Chart(document.getElementById("barChart"), {
    type: "bar",
    data: {
        labels: d.priorities.map(p => "Priority " + p),
        datasets: [{
            label: "Number of Tasks",
            data: d.priority_counts,
            backgroundColor: "#3b82f6"
        }]
    },
    options: {
        ...commonOptions,
        scales: {
            y: {
                beginAtZero: true,
                ticks: { precision: 0 }
            }
        }
    }
});

new Chart(document.getElementById("statusChart"), {
    type: "bar",
    data: {
        labels: ["Tasks"],
        datasets: [
            {
                label: "Completed",
                data: [d.done],
                backgroundColor: "#22c55e"
            },
            {
                label: "Pending",
                data: [d.pending],
                backgroundColor: "#f59e0b"
            }
        ]
    },
    options: {
        ...commonOptions,
        scales: {
            x: { stacked: true },
            y: {
                stacked: true,
                beginAtZero: true,
                ticks: { precision: 0 }
            }
        }
    }
});
</script>

</body>
</html>
